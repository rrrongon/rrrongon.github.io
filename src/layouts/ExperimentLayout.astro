---
const { frontmatter } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title} | Rubayet Rahman Rongon</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      crossorigin="anonymous"
    />
    <style is:global>
      :root {
        --bg: #ffffff;
        --surface: #f8fafc;
        --border: #e2e8f0;
        --text: #0f172a;
        --muted: #475569;
        --accent: #2563eb;
        --code-bg: #f1f5f9;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.65;
        color: var(--text);
        background: var(--bg);
        max-width: 860px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 5rem;
      }
      nav {
        margin-bottom: 2rem;
        font-size: 0.9rem;
      }
      nav a {
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
      }
      header {
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }
      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        font-size: 0.82rem;
        color: var(--muted);
      }
      .tag {
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 0.15rem 0.55rem;
        border-radius: 4px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      h1 {
        font-size: 1.95rem;
        line-height: 1.25;
        margin: 0.25rem 0 0.75rem;
      }
      .subtitle {
        color: var(--muted);
        font-size: 1.05rem;
        margin: 0;
      }
      .highlights {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 0.75rem;
        margin-top: 1.25rem;
      }
      .highlight-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.75rem 1rem;
      }
      .highlight-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
      }
      .highlight-value {
        font-size: 1.15rem;
        font-weight: 700;
        margin-top: 0.15rem;
      }
      h2 {
        margin-top: 2.5rem;
        padding-bottom: 0.35rem;
        border-bottom: 1px solid var(--border);
        font-size: 1.4rem;
      }
      h3 {
        margin-top: 1.75rem;
        font-size: 1.12rem;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.25rem 0;
        font-size: 0.92rem;
      }
      th, td {
        border: 1px solid var(--border);
        padding: 0.6rem 0.75rem;
        text-align: left;
        vertical-align: top;
      }
      th {
        background: var(--surface);
        font-weight: 600;
      }
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        background: var(--code-bg);
        padding: 0.12rem 0.35rem;
        border-radius: 4px;
        font-size: 0.88em;
      }
      pre {
        background: #0f172a;
        color: #f8fafc;
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.5;
      }
      pre code {
        background: transparent;
        padding: 0;
        color: inherit;
      }
      details {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.75rem 1rem;
        margin: 1.25rem 0;
      }
      summary {
        cursor: pointer;
        font-weight: 600;
        color: var(--accent);
      }
      .katex-display {
        overflow-x: auto;
        padding: 0.5rem 0;
      }
    </style>
  </head>
  <body>
    <nav><a href="/">← All Experiments & Systems</a></nav>

    <header>
      <div class="meta">
        <span>{frontmatter.date}</span>
        {frontmatter.tags?.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
      <h1>{frontmatter.title}</h1>
      <p class="subtitle">{frontmatter.summary}</p>

      {frontmatter.highlights && (
        <div class="highlights">
          {frontmatter.highlights.map((item: { label: string; value: string }) => (
            <div class="highlight-card">
              <div class="highlight-label">{item.label}</div>
              <div class="highlight-value">{item.value}</div>
            </div>
          ))}
        </div>
      )}
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>
